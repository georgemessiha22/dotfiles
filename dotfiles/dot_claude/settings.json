{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "autoMemoryDirectory": "~/HungerStation/Hungerstation.wiki/memory",
  "autoMemoryEnabled": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "postman@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
    ],
    "PreToolUse": [
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/george/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ]
  },
  "model": "sonnet[1m]",
  "permissions": {
    "defaultMode": "plan"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
