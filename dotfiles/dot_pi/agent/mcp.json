{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${HOMEBREW_GITHUB_API_TOKEN}"
      }
    },
    "dp-devinfra": {
      "command": "dp-devinfra",
      "args": [
        "mcp"
      ]
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "mcp-server-kubernetes@3.5.1"
      ],
      "env": {
        "SPAWN_MAX_BUFFER": "10485760",
        "ALLOW_ONLY_READONLY_TOOLS": "true"
      },
      "enabled": false
    },
    "drive": {
      "url": "https://drivemcp.googleapis.com/mcp/v1",
      "enabled": false
    },
    "slack": {
      "command": "/Users/george/projects/pd-mcp-servers/pd-slack-mcp-server/slack-mcp"
    },
    "testrails": {
      "command": "npx",
      "args": [
        "@bun913/mcp-testrail@latest"
      ],
      "env": {
        "TESTRAIL_URL": "https://hungerstation.testrail.io",
        "TESTRAIL_USERNAME": "${TESTRAIL_USER}",
        "TESTRAIL_API_KEY": "${TESTRAIL_API_KEY}"
      }
    }
  }
}
