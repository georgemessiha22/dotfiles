{
  "lastChangelogVersion": "1.5.2",
  "theme": "opencode",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.7",
  "defaultThinkingLevel": "high",
  "showHardwareCursor": true,
  "editorPaddingX": 2,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "doubleEscapeAction": "tree",
  "externalEditor": "nvim",
  "quietStartup": false,
  "collapseChangelog": true,
  "autocompleteMaxVisible": 8,
  "enableInstallTelemetry": false,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "defaultTools": [
    "+codemode"
  ],
  "compaction": {
    "reserveTokens": 50000
  },
  "packages": [
    "npm:pi-hermes-memory",
    "npm:@juanibiapina/pi-powerbar",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "./local/pi-sidebar-tui",
    "npm:pi-lsp-adapter",
    "git:github.com/obra/superpowers",
    "npm:@adeildo/pi-ask-questions"
  ],
  "extensions": [
    "-builtin:mcp",
    "./local/plan-mode/index.ts"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.88.1"
  }
}
