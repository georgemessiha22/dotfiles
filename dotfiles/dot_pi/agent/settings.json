{
  "lastChangelogVersion": "1.5.0",
  "theme": "opencode",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.7",
  "defaultThinkingLevel": "medium",
  "showHardwareCursor": true,
  "editorPaddingX": 2,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "enableInstallTelemetry": false,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "packages": [
    "npm:pi-hermes-memory",
    "npm:@juanibiapina/pi-powerbar",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "./local/pi-sidebar-tui",
    "npm:pi-lsp-adapter",
    "git:github.com/obra/superpowers"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "doubleEscapeAction": "tree",
  "externalEditor": "nvim",
  "extensions": [
    "-builtin:mcp",
    "./local/claude-project-config.ts",
    "./local/plan-mode/index.ts"
  ],
  "skills": [
    "~/.agents/skills",
    "~/.config/opencode/skills"
  ],
  "quietStartup": false,
  "collapseChangelog": true,
  "autocompleteMaxVisible": 8,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0"
  }
}