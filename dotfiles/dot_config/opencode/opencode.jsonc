{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "Hungerstation.wiki/AGENTS.md",
        "CONTRIBUTING.md",
        "docs/guidelines.md",
        ".agents/rules/*.md",
        ".agents/AGENTS.md",
        "README.md"
    ],
    "skills": [
        "~/.config/opencode/skills/",
        "Hungerstation.wiki/skills/",
        ".agents/skills/",
        ".opencode/skills/",
        ".claude/skills/"
    ],
    "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" }
    ],
    "shell": "fish",
    "default_agent": "plan",
    "model": "github-copilot/claude-sonnet-5.5",
    "update": "auto",
    "mcp": {
        "servers": {
            "github": {
                "type": "remote",
                "disabled": false,
                "url": "https://api.githubcopilot.com/mcp/",
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {env:HOMEBREW_GITHUB_API_TOKEN}"
                }
            },
            "kubernetes": {
                "type": "local",
                "disabled": true,
                "command": [
                    "npx",
                    "mcp-server-kubernetes@3.5.1"
                ],
                "environment": {
                    "SPAWN_MAX_BUFFER": "10485760",
                    "ALLOW_ONLY_READONLY_TOOLS": "true"
                }
            },
            "dp-devinfra": {
                "type": "local",
                "disabled": false,
                "command": [
                    "dp-devinfra",
                    "mcp"
                ]
            },
            "atlassian": {
                "type": "remote",
                "url": "https://mcp.atlassian.com/v1/mcp",
                "disabled": false
            },
            "drive": {
                "type": "remote",
                "url": "https://drivemcp.googleapis.com/mcp/v1",
                "disabled": true,
            },
            "slack": {
                "type": "local",
                "command": [
                    "/Users/george/projects/pd-mcp-servers/pd-slack-mcp-server/slack-mcp"
                ],
                "disabled": true,
            },
            "testrails": {
                "type": "local",
                "command": [
                    "npx",
                    "@bun913/mcp-testrail@latest"
                ],
                "environment": {
                    "TESTRAIL_URL": "https://hungerstation.testrail.io",
                    "TESTRAIL_USERNAME": "{env:TESTRAIL_USER}",
                    "TESTRAIL_API_KEY": "{env:TESTRAIL_API_KEY}"
                },
                "disabled": true,
            },
            // "grafana": {
            //     "type": "remote",
            //     "url": "https://mcp.grafana.com/mcp",
            //     "headers": {
            //         "X-Grafana-URL": "https://deliveryhero.grafana.net"
            //     }
            // }
        }
    },
    "providers": {
        "ollama": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "settings": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "qwen2.5-coder:1.5b": {
                    "name": "QWEN-coder 2.5"
                }
            }
        },
        "anthropic": {
            "settings": {
                "apiKey": "{env:CLAUDE_CODE_OAUTH_TOKEN}"
            }
        }
    },
    "plugins": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "opencode-gemini-auth",
    ],
    "lsp": true,
}
